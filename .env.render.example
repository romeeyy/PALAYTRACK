APP_NAME=PalayTrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://palaytrack-test.onrender.com

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
PALAYTRACK_LOW_INVENTORY_THRESHOLD=100

FILESYSTEM_DISK=local

SMS_MODE=simulation
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=JKDIEZ

RUN_INITIAL_SEEDER=true
INITIAL_OWNER_NAME="Test Owner"
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
